# Copy to .env and adjust. Compose reads this automatically.

# Postgres
POSTGRES_USER=taskhat
POSTGRES_PASSWORD=taskhat_dev_password
POSTGRES_DB=taskhat

# Backend
TASKHAT_DB_URL=postgres://taskhat:taskhat_dev_password@postgres:5432/taskhat?sslmode=disable
TASKHAT_REDIS_URL=redis://redis:6379/0
TASKHAT_AMQP_URL=amqp://taskhat:taskhat_dev_password@rabbitmq:5672/
TASKHAT_JWT_SECRET=change_me_in_prod_32_bytes_minimum!!
TASKHAT_BASE_URL=http://localhost:8080
TASKHAT_LISTEN_ADDR=:8081
TASKHAT_ENV=dev

# RabbitMQ
RABBITMQ_DEFAULT_USER=taskhat
RABBITMQ_DEFAULT_PASS=taskhat_dev_password

# S3-compatible object storage for attachments (optional; empty = local volume)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_PUBLIC_BASE_URL=
S3_PRESIGNED_EXP_SECONDS=900
S3_MEDIA_PRIVATE=true
